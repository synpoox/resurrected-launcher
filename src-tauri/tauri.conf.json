{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Resurrected",
  "mainBinaryName": "resurrected-launcher",
  "version": "0.1.3",
  "identifier": "com.projectd2r.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["resources/7zip/*"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENENDdDN0NBNEY0MDc0RDMKUldUVGRFQlB5c2RIemN1WTd1UFJ5ZFhTQ1RSZ3ZJRWJ6R24wOXpEZWo3emtIcnR4WGxiOGQxYmUK",
      "endpoints": ["https://github.com/synpoox/resurrected-launcher/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
