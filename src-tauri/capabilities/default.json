{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Grants only the launcher's own typed commands, plus subscribing to the launcher's events (core:event listen/unlisten, never emit); no other core or plugin permissions.",
  "windows": ["main"],
  "permissions": [
    "allow-ping",
    "allow-get-product-state",
    "allow-inspect-operation",
    "allow-start-operation",
    "allow-cancel-operation",
    "allow-recover-product",
    "allow-detect-game-locations",
    "allow-choose-game-location",
    "allow-refresh-catalog",
    "allow-play-product",
    "allow-open-loader-download-page",
    "allow-select-game-location",
    "allow-get-release-notes",
    "allow-open-folder",
    "allow-preview-diagnostics",
    "allow-save-diagnostics",
    "allow-show-diagnostics-in-folder",
    "allow-get-start-with-windows",
    "allow-set-start-with-windows",
    "allow-minimize-window",
    "allow-toggle-maximize-window",
    "allow-close-window",
    "allow-start-window-drag",
    "allow-quit-launcher",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
