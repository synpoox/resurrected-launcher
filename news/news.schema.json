{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synpoox/resurrected-launcher/blob/main/news/news.schema.json",
  "title": "Launcher news, schema_version 1",
  "description": "Mirrors src-tauri/src/catalog/news.rs and is never looser than it: every file this accepts, News::parse accepts. news/fixtures keeps the two in sync (news_fixtures in news.rs, scripts/check-news.py here). The whole file must be at most 64 KB.",
  "type": "object",
  "required": ["schema_version", "items"],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": { "pattern": "[\\x00-\\x1f\\x7f-\\x9f\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]" }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["product_id", "kind", "title", "published", "url"],
        "properties": {
          "product_id": { "enum": ["pd2r", "project-forever", "project-09"] },
          "kind": { "enum": ["announcement", "guide"] },
          "title": { "$ref": "#/$defs/text", "maxLength": 120 },
          "summary": { "$ref": "#/$defs/text", "maxLength": 200 },
          "published": {
            "type": "string",
            "description": "YYYY-MM-DD or YYYY-MM-DDTHH:MM:SSZ: a real date, year 2000 or later. The lengths stop `$` from matching before a trailing newline.",
            "anyOf": [
              {
                "minLength": 10,
                "maxLength": 10,
                "pattern": "^([2-9][0-9]{3}-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([2-9][0-9](0[48]|[2468][048]|[13579][26])|([2468][048]|[3579][26])00)-02-29)$"
              },
              {
                "minLength": 20,
                "maxLength": 20,
                "pattern": "^([2-9][0-9]{3}-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([2-9][0-9](0[48]|[2468][048]|[13579][26])|([2468][048]|[3579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
              }
            ]
          },
          "url": {
            "type": "string",
            "description": "https on github.com, discord.gg or discord.com, then only link_char (news.rs). No dot segments or %2e in the path.",
            "maxLength": 512,
            "pattern": "^https://(github\\.com|discord\\.gg|discord\\.com)([/?#][A-Za-z0-9._~/?#\\[\\]@!$&'()*+;=%-]*)?$",
            "not": {
              "anyOf": [
                { "pattern": "[^A-Za-z0-9._~/?#\\[\\]@!$&'()*+;=%:-]" },
                { "pattern": "^https://[^?#]*/\\.\\.?([/?#]|$)" },
                { "pattern": "^https://[^?#]*%2[eE]" }
              ]
            }
          }
        }
      }
    }
  }
}
